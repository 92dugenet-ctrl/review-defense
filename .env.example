REVIEW_DEFENSE_ENV=production
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgresql://review_defense:change-me@postgres:5432/review_defense
SECURE_HEADERS=true
TRUST_PROXY=false
MAX_REQUEST_BYTES=1000000
EVIDENCE_MAX_REQUEST_BYTES=35000000

# V6.24 MFA
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REVIEW_DEFENSE_MFA_ENCRYPTION_KEY=
# Development-only test convenience; MUST remain false/unset in production.
REVIEW_DEFENSE_EXPOSE_RECOVERY_TOKEN=false

# V6.25 authentication email delivery
REVIEW_DEFENSE_RECOVERY_EMAIL_ENABLED=false
REVIEW_DEFENSE_REQUIRE_EMAIL_VERIFICATION=false
REVIEW_DEFENSE_PUBLIC_BASE_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_STARTTLS=true

# V6.41 client monitoring / Google Business Profile
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
REVIEW_DEFENSE_GOOGLE_STATE_KEY=
REVIEW_DEFENSE_GOOGLE_TOKEN_KEY=
