# Modèle d'environnement pour les stacks Docker Compose de production/staging.
# Copier dans un fichier .env non versionné puis remplacer chaque valeur d'exemple.
# Ne jamais committer de secret réel. Les secrets restent dans l'environnement d'hébergement.
#
# Le nom de domaine example.com est réservé à la documentation : le remplacer.
# Pour un développement local sans Compose, définir REVIEW_DEFENSE_ENV=development
# et REVIEW_DEFENSE_PUBLIC_BASE_URL=http://localhost:8080 dans son environnement local.

# --- Application et reverse proxy ---
REVIEW_DEFENSE_ENV=production
HOST=0.0.0.0
PORT=8080
REVIEW_DEFENSE_PUBLIC_BASE_URL=https://review-defense.example.com
REVIEW_DEFENSE_DOMAIN=review-defense.example.com
TLS_ADMIN_EMAIL=ops@example.com
TRUST_PROXY=true
SECURE_HEADERS=true
MAX_REQUEST_BYTES=1000000
EVIDENCE_MAX_REQUEST_BYTES=35000000
REVIEW_DEFENSE_EVIDENCE_ROOT=/data/evidence

# --- PostgreSQL ---
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://review_defense:replace-with-a-long-random-password@postgres:5432/review_defense

# --- Gunicorn : réglages du serveur web ---
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60

# --- Authentification multifacteur ---
# Générer une clé Fernet dédiée et la stocker uniquement dans le gestionnaire de secrets.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REVIEW_DEFENSE_MFA_ENCRYPTION_KEY=
REVIEW_DEFENSE_EXPOSE_RECOVERY_TOKEN=false

# --- Emails transactionnels ---
# Laisser les deux options à false tant que le transport SMTP n'est pas configuré.
REVIEW_DEFENSE_RECOVERY_EMAIL_ENABLED=false
REVIEW_DEFENSE_REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=noreply@example.com
SMTP_STARTTLS=true

# --- PayPal ---
PAYPAL_ENV=production
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Google Business Profile OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
REVIEW_DEFENSE_GOOGLE_STATE_KEY=
REVIEW_DEFENSE_GOOGLE_TOKEN_KEY=

# --- Worker : variables pour un processus séparé, pas pour le serveur web ---
# Le worker actuel traite un seul job par invocation. Ne pas créer de service
# permanent avant d'avoir défini les handlers et le superviseur.
REVIEW_DEFENSE_WORKER_ORGANIZATION_ID=
REVIEW_DEFENSE_WORKER_ID=
REVIEW_DEFENSE_JOB_HANDLERS=
