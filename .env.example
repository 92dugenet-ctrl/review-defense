# Modèle des variables d'environnement. Copier dans un fichier local non versionné,
# puis remplacer les valeurs d'exemple. Ne jamais committer de secrets réels.
# Les variables effectivement consommées sont lues par src/production_config.py,
# src/deployment.py et les modules d'intégration.

# --- Serveur et base de données ---
REVIEW_DEFENSE_ENV=production
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgresql://review_defense:change-me@postgres:5432/review_defense
SECURE_HEADERS=true
TRUST_PROXY=false
MAX_REQUEST_BYTES=1000000
EVIDENCE_MAX_REQUEST_BYTES=35000000
# Monter un volume privé persistant sur ce chemin en production.
REVIEW_DEFENSE_EVIDENCE_ROOT=/var/lib/review-defense/evidence

# --- Authentification multifacteur (MFA) ---
# Générer une clé Fernet dédiée ; ne jamais réutiliser une clé publique ou la committer.
# Génération : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REVIEW_DEFENSE_MFA_ENCRYPTION_KEY=
# Option réservée au développement ; doit rester false/non définie en production.
REVIEW_DEFENSE_EXPOSE_RECOVERY_TOKEN=false

# --- Emails de récupération et vérification ---
REVIEW_DEFENSE_RECOVERY_EMAIL_ENABLED=false
REVIEW_DEFENSE_REQUIRE_EMAIL_VERIFICATION=false
REVIEW_DEFENSE_PUBLIC_BASE_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=gabriel.reviewdefense@gmail.com
SMTP_STARTTLS=true

# --- PayPal : identifiants privés à fournir par l'environnement ---
# Ne pas ajouter de secrets réels dans ce fichier ou dans Git.
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- OAuth Google Business Profile ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
REVIEW_DEFENSE_GOOGLE_STATE_KEY=
REVIEW_DEFENSE_GOOGLE_TOKEN_KEY=
